{
	"name": "aidenclarkmusic-website",
	"version": "0.2.0",
	"type": "module",
	"engines": {
		"node": ">=22.22.0"
	},
	"scripts": {
		"start": "vite",
		"build": "tsc && vite build",
		"postbuild": "react-snap --single-process",
		"preview": "vite preview --outDir build"
	},
	"dependencies": {
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-ga4": "^3.0.1",
		"react-router": "^8.5.1"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.2.1",
		"react-snap": "^1.23.0",
		"sass": "^1.108.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.6"
	},
	"reactSnap": {
		"minifyHtml": {
			"collapseBooleanAttributes": true,
			"collapseWhitespace": true,
			"decodeEntities": true,
			"keepClosingSlash": true,
			"sortAttributes": false,
			"sortClassName": false
		}
	}
}
